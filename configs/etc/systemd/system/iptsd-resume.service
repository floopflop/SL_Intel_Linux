[Unit]
Description=Restart iptsd after resume (quickspi firmware falls back to mouse mode)
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
# systemctl matches the glob against the loaded units (the running iptsd@dev-hidrawN.service);
# with no match it does nothing and exits 0. The '-' ignores a failure of the restart itself.
ExecStart=-/usr/bin/systemctl restart 'iptsd@*.service'

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

+/*
+ * Diagnostics (LIBCAMERA_SOFTISP_STALECHECK=1): compare the content of an input
+ * buffer with what the same buffer held when it was last processed. Live 64 byte
+ * chunks (10 bit samples, unclipped, not flat) that are bit-identical were not
+ * rewritten by the capture DMA. Counted right away and again after 15 ms, to
+ * tell writes that land late from writes that never land.
+ */
+void Debayer::staleCheck(FrameBuffer *input, unsigned int stride, unsigned int width, unsigned int height)
+{
+	const int fd = input->planes()[0].fd.get();
+	auto it = inputMaps_.find(fd);
+	if (it == inputMaps_.end()) {
+		auto map = std::make_unique<MappedFrameBuffer>(input, MappedFrameBuffer::MapFlag::Read);
+		if (!map->isValid())
+			return;
+		it = inputMaps_.emplace(fd, std::move(map)).first;
+	}
+	const uint8_t *data = it->second->planes()[0].data();
+	const size_t size = it->second->planes()[0].size();
+	const unsigned int rowBytes = width * 2;
+
+	unsigned int rowMin = height, rowMax = 0, rows = 0;
+	auto count = [&](const std::vector<uint8_t> &prev) {
+		unsigned int n = 0;
+		rowMin = height; rowMax = 0; rows = 0;
+		for (unsigned int y = 0; y < height; y++) {
+			unsigned int inRow = 0;
+			const uint8_t *row = data + (size_t)y * stride;
+			const uint8_t *old = prev.data() + (size_t)y * stride;
+			for (unsigned int c = 0; c + 64 <= rowBytes; c += 64) {
+				if (memcmp(row + c, old + c, 64))
+					continue;
+				const uint16_t *v = reinterpret_cast<const uint16_t *>(row + c);
+				uint16_t mn = 1023, mx = 0;
+				for (int k = 0; k < 32; k++) {
+					mn = std::min(mn, v[k]);
+					mx = std::max(mx, v[k]);
+				}
+				if (mx < 1000 && mx - mn > 6) {
+					n++;
+					inRow++;
+				}
+			}
+			if (inRow) {
+				rows++;
+				rowMin = std::min(rowMin, y);
+				rowMax = std::max(rowMax, y);
+			}
+		}
+		return n;
+	};
+
+	auto prev = staleCopies_.find(fd);
+	if (prev != staleCopies_.end() && prev->second.size() == size) {
+		unsigned int cached = count(prev->second);	/* as the CPU sees it, caches untouched */
+		flushInputCache(input);
+		unsigned int now = count(prev->second);		/* what memory holds */
+		unsigned int later[3] = {};
+		if (now) {
+			for (int i = 0; i < 3; i++) {
+				std::this_thread::sleep_for(std::chrono::milliseconds(i == 0 ? 15 : i == 1 ? 15 : 30));
+				flushInputCache(input);
+				later[i] = count(prev->second);
+			}
+		}
+		LOG(Debayer, Info) << "stalecheck seq " << input->metadata().sequence << " fd " << fd
+				   << ": old-content chunks: cached view " << cached
+				   << ", memory " << now << ", after 15/30/60 ms " << later[0] << "/" << later[1] << "/" << later[2]
+				   << (now ? " in rows " + std::to_string(rowMin) + "-" + std::to_string(rowMax) + " (" + std::to_string(rows) + " rows)" : "");
+	}
+	staleCopies_[fd].assign(data, data + size);
+}
+
 } /* namespace libcamera */

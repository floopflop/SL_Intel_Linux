+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Red Hat Inc.
+ *
+ * Software ISP spatial denoise strength
+ *
+ * The filtering itself runs in the debayer backend; this algorithm only picks
+ * the filter sigmas for each frame from the analogue gain the frame was
+ * captured with, as sensor noise grows roughly with the gain.
+ */
+
+#include "denoise.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftDenoise)
+
+int Denoise::parseCurve(const ValueNode &node, Curve &curve)
+{
+	curve.clear();
+
+	if (!node.isList())
+		return 0;
+
+	for (const auto &point : node.asList()) {
+		const auto gain = point["gain"].get<double>();
+		const auto sigma = point["sigma"].get<double>();
+
+		if (!gain || !sigma || *gain <= 0.0 || *sigma < 0.0) {
+			LOG(IPASoftDenoise, Error) << "Invalid denoise curve point";
+			return -EINVAL;
+		}
+
+		curve.emplace_back(*gain, *sigma);
+	}
+
+	std::sort(curve.begin(), curve.end());
+	return 0;
+}
+
+/* Piecewise linear in log(gain), clamped at both ends. */
+double Denoise::interpolate(const Curve &curve, double gain)
+{
+	if (curve.empty())
+		return 0.0;
+	if (gain <= curve.front().first)
+		return curve.front().second;
+	if (gain >= curve.back().first)
+		return curve.back().second;
+
+	for (size_t i = 1; i < curve.size(); i++) {
+		const auto &[g0, s0] = curve[i - 1];
+		const auto &[g1, s1] = curve[i];
+		if (gain > g1)
+			continue;
+
+		const double t = (std::log(gain) - std::log(g0)) /
+				 (std::log(g1) - std::log(g0));
+		return s0 + (s1 - s0) * t;
+	}
+
+	return curve.back().second;
+}
+
+int Denoise::init(IPAContext &context, const ValueNode &tuningData)
+{
+	int ret = parseCurve(tuningData["chroma"], chroma_);
+	if (ret)
+		return ret;
+
+	ret = parseCurve(tuningData["luma"], luma_);
+	if (ret)
+		return ret;
+
+	lumaStrength_ = std::clamp(tuningData["lumaStrength"].get<double>(0.0), 0.0, 1.0);
+
+	/*
+	 * Temporal (recursive) filter in the GPU backend: `temporal` is the
+	 * per-pixel noise sigma by gain that scales the motion thresholds,
+	 * temporalStrength / temporalChromaStrength the luma and chroma
+	 * weights of the previous frame where nothing moved (chroma defaults
+	 * to the luma value; both 0 = off), temporalMotionLow /
+	 * temporalMotionHigh the thresholds in sigmas.
+	 */
+	ret = parseCurve(tuningData["temporal"], temporal_);
+	if (ret)
+		return ret;
+	temporalStrength_ = std::clamp(tuningData["temporalStrength"].get<double>(0.0), 0.0, 0.95);
+	temporalChromaStrength_ = std::clamp(tuningData["temporalChromaStrength"].get<double>(temporalStrength_),
+					     0.0, 0.95);
+	temporalLow_ = std::clamp(tuningData["temporalMotionLow"].get<double>(1.5), 0.0, 20.0);
+	temporalHigh_ = std::clamp(tuningData["temporalMotionHigh"].get<double>(3.5),
+				   static_cast<double>(temporalLow_) + 0.1, 40.0);
+	if (temporal_.empty())
+		temporalStrength_ = temporalChromaStrength_ = 0.0f;
+
+	if (chroma_.empty() && luma_.empty() && temporalStrength_ <= 0.0f &&
+	    temporalChromaStrength_ <= 0.0f) {
+		LOG(IPASoftDenoise, Warning) << "No denoise curves, algorithm disabled";
+		return 0;
+	}
+
+	context.denoiseEnabled = true;
+
+	LOG(IPASoftDenoise, Debug) << "Loaded " << chroma_.size() << " chroma and "
+				   << luma_.size() << " luma curve points, temporal strength "
+				   << temporalStrength_ << " (" << temporal_.size() << " points)";
+	return 0;
+}
+
+/*
+ * The frame context carries no sensor values yet when the ISP parameters are
+ * computed (they arrive with the statistics, after the frame was processed),
+ * so the gain of the most recent frame that had statistics is kept in the
+ * active state by process() and used here: one frame old, but what the
+ * sensor actually applied.
+ */
+void Denoise::process(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		      IPAFrameContext &frameContext,
+		      [[maybe_unused]] const SwIspStats *stats,
+		      [[maybe_unused]] ControlList &metadata)
+{
+	if (frameContext.sensor.gain > 0.0)
+		context.activeState.denoise.gain = frameContext.sensor.gain;
+}
+
+void Denoise::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext, DebayerParams *params)
+{
+	double gain = context.activeState.denoise.gain;
+	if (gain <= 0.0)
+		gain = context.activeState.agc.valid ? context.activeState.agc.again : 1.0;
+
+	params->denoise.chromaSigma = static_cast<float>(interpolate(chroma_, gain) / 255.0);
+	params->denoise.lumaSigma = static_cast<float>(interpolate(luma_, gain) / 255.0);
+	params->denoise.lumaStrength = luma_.empty() ? 0.0f : lumaStrength_;
+	params->denoise.temporalStrength = temporalStrength_;
+	params->denoise.temporalChromaStrength = temporalChromaStrength_;
+	params->denoise.temporalSigma = static_cast<float>(interpolate(temporal_, gain) / 255.0);
+	params->denoise.temporalLow = temporalLow_;
+	params->denoise.temporalHigh = temporalHigh_;
+}
+
+REGISTER_IPA_ALGORITHM(Denoise, "Denoise")
+

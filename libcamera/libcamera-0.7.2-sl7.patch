+	if (egl_.linkProgram(denoiseProgramId_, vertexShaderId, fragmentShaderId)) {
+		LOG(Debayer, Error) << "Linking denoise program fail";
+		return -ENODEV;
+	}
+
+	dnAttributeVertex_ = glGetAttribLocation(denoiseProgramId_, "vertexIn");
+	dnAttributeTexture_ = glGetAttribLocation(denoiseProgramId_, "textureIn");
+	dnUniformTex_ = glGetUniformLocation(denoiseProgramId_, "tex_y");
+	dnUniformStep_ = glGetUniformLocation(denoiseProgramId_, "tex_step");
+	dnUniformStrideFactor_ = glGetUniformLocation(denoiseProgramId_, "stride_factor");
+	dnUniformProjMatrix_ = glGetUniformLocation(denoiseProgramId_, "proj_matrix");
+	dnUniformChromaSigma_ = glGetUniformLocation(denoiseProgramId_, "chromaSigma");
+	dnUniformLumaSigma_ = glGetUniformLocation(denoiseProgramId_, "lumaSigma");
+	dnUniformLumaStrength_ = glGetUniformLocation(denoiseProgramId_, "lumaStrength");
+
+	return 0;
+}

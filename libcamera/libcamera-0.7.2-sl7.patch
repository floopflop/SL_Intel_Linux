+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class LensShadingCorrection : public Algorithm
+{
+public:
+	LensShadingCorrection() = default;
+	~LensShadingCorrection() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+
+private:
+	/*
+	 * One shading component: either a radial polynomial (type: polynomial)
+	 * or an explicit gain grid spanning the full frame (type: grid), e.g.
+	 * the per-unit calibration from the module's EEPROM.
+	 */
+	struct Component {
+		std::optional<ipa::LscPolynomial> poly;
+		std::vector<float> grid;
+	};
+	using Components = std::map<std::string, Component, std::less<>>;
+
+	void sampleInto(const Component &component,
+			float dst[DebayerParams::kLscGridHeight]
+				 [DebayerParams::kLscGridWidth]) const;
+	void samplePolynomial(const ipa::LscPolynomial &poly,
+			      float dst[DebayerParams::kLscGridHeight]
+				       [DebayerParams::kLscGridWidth]) const;
+	void sampleGrid(const std::vector<float> &grid,
+			float dst[DebayerParams::kLscGridHeight]
+				 [DebayerParams::kLscGridWidth]) const;
+
+	unsigned int gridWidth_ = 0;
+	unsigned int gridHeight_ = 0;
+
+	std::map<unsigned int, Components> sets_;
+	Rectangle crop_;
+	Size sensorSize_;
+	unsigned int lastCt_ = 0;
+	double ctFiltered_ = 0.0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */

+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Red Hat Inc.
+ *
+ * Software ISP lens shading correction
+ *
+ * Self contained rather than built on libipa's shared LscAlgorithm, which does
+ * not exist in this release. It parses radial polynomials directly and samples
+ * them over the sensor's analogue crop.
+ */
+
+#include "lsc.h"
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftLsc)
+
+namespace {
+
+const char *kComponents[] = { "r", "gr", "gb", "b" };
+
+std::optional<ipa::LscPolynomial> parsePolynomial(const ValueNode &node)
+{
+	const auto cx = node["cx"].get<double>();
+	const auto cy = node["cy"].get<double>();
+	const auto k0 = node["k0"].get<double>();
+	const auto k1 = node["k1"].get<double>();
+	const auto k2 = node["k2"].get<double>();
+	const auto k3 = node["k3"].get<double>();
+	const auto k4 = node["k4"].get<double>();
+
+	if (!cx || !cy || !k0 || !k1 || !k2 || !k3 || !k4)
+		return {};
+
+	return ipa::LscPolynomial(*cx, *cy, *k0, *k1, *k2, *k3, *k4);
+}
+
+} /* namespace */
+
+void LensShadingCorrection::sampleInto(const Component &component,
+				       float dst[DebayerParams::kLscGridHeight]
+						[DebayerParams::kLscGridWidth]) const
+{
+	if (component.poly)
+		samplePolynomial(*component.poly, dst);
+	else
+		sampleGrid(component.grid, dst);
+}
+
+/*
+ * Resample an explicit gain grid, whose nodes span the full frame with the
+ * first and last node on the frame edges, onto the backend's grid.
+ */
+void LensShadingCorrection::sampleGrid(const std::vector<float> &grid,
+				       float dst[DebayerParams::kLscGridHeight]
+						[DebayerParams::kLscGridWidth]) const
+{
+	const unsigned int gw = gridWidth_, gh = gridHeight_;
+	for (unsigned int y = 0; y < DebayerParams::kLscGridHeight; y++) {
+		const double v = static_cast<double>(y) / (DebayerParams::kLscGridHeight - 1) * (gh - 1);
+		const unsigned int y0 = std::min<unsigned int>(static_cast<unsigned int>(v), gh - 2);
+		const double fy = v - y0;
+		for (unsigned int x = 0; x < DebayerParams::kLscGridWidth; x++) {
+			const double u = static_cast<double>(x) / (DebayerParams::kLscGridWidth - 1) * (gw - 1);
+			const unsigned int x0 = std::min<unsigned int>(static_cast<unsigned int>(u), gw - 2);
+			const double fx = u - x0;
+			const double top = grid[y0 * gw + x0] * (1 - fx) + grid[y0 * gw + x0 + 1] * fx;
+			const double bottom = grid[(y0 + 1) * gw + x0] * (1 - fx) + grid[(y0 + 1) * gw + x0 + 1] * fx;
+			dst[y][x] = static_cast<float>(top * (1 - fy) + bottom * fy);
+		}
+	}
+}
+
+int LensShadingCorrection::init(IPAContext &context, const ValueNode &tuningData)
+{
+	const ValueNode &sets = tuningData["sets"];
+	if (!sets.isList()) {
+		LOG(IPASoftLsc, Error) << "'sets' not found in tuning data";
+		return -EINVAL;
+	}
+
+	/*
+	 * type: polynomial (default) - radial polynomials per component;
+	 * type: grid - explicit gain grids of width x height nodes per
+	 * component, spanning the full frame, e.g. per-unit calibration data.
+	 */
+	const std::string type = tuningData["type"].get<std::string>("polynomial");
+	const bool useGrid = type == "grid";
+	if (useGrid) {
+		gridWidth_ = tuningData["width"].get<uint32_t>(0);
+		gridHeight_ = tuningData["height"].get<uint32_t>(0);
+		if (gridWidth_ < 2 || gridHeight_ < 2) {
+			LOG(IPASoftLsc, Error) << "Grid shading needs 'width' and 'height' >= 2";
+			return -EINVAL;
+		}
+	} else if (type != "polynomial") {
+		LOG(IPASoftLsc, Error) << "Unknown shading type '" << type << "'";
+		return -EINVAL;
+	}
+
+	for (const auto &set : sets.asList()) {
+		const auto ct = set["ct"].get<uint32_t>();
+		if (!ct) {
+			LOG(IPASoftLsc, Error) << "A shading set has no 'ct'";
+			return -EINVAL;
+		}
+
+		Components components;
+		for (const char *key : kComponents) {
+			Component component;
+			if (useGrid) {
+				const ValueNode &list = set[key];
+				if (list.isList()) {
+					for (const auto &v : list.asList())
+						component.grid.push_back(static_cast<float>(v.get<double>(1.0)));
+				}
+				if (component.grid.size() != gridWidth_ * gridHeight_) {
+					LOG(IPASoftLsc, Error)
+						<< "Shading set " << *ct << " component '" << key
+						<< "' needs " << gridWidth_ * gridHeight_ << " values";
+					return -EINVAL;
+				}
+			} else {
+				auto poly = parsePolynomial(set[key]);
+				if (!poly) {
+					LOG(IPASoftLsc, Error)
+						<< "Shading set " << *ct
+						<< " is missing or has an incomplete '"
+						<< key << "' polynomial";
+					return -EINVAL;
+				}
+				component.poly = *poly;
+			}
+			components.emplace(key, std::move(component));
+		}
+
+		sets_[*ct] = std::move(components);
+	}
+
+	if (sets_.empty()) {
+		LOG(IPASoftLsc, Error) << "No shading sets were loaded";
+		return -EINVAL;
+	}
+
+	context.lscEnabled = true;
+	LOG(IPASoftLsc, Debug) << "Loaded " << sets_.size() << " shading sets";
+
+	return 0;
+}
+
+int LensShadingCorrection::configure(IPAContext &context,
+				     [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	sensorSize_ = context.sensorInfo.activeAreaSize;
+	crop_ = context.sensorInfo.analogCrop;
+	lastCt_ = 0;
+
+	/*
+	 * The polynomials are defined over the whole active pixel array, so
+	 * that is the reference the radius is normalised against.
+	 */
+	for (auto &[ct, components] : sets_)
+		for (auto &[key, component] : components)
+			if (component.poly)
+				component.poly->setReferenceImageSize(sensorSize_);
+
+	LOG(IPASoftLsc, Debug)
+		<< "Shading over crop " << crop_ << " of active area " << sensorSize_;
+
+	return 0;
+}
+
+/*
+ * Evaluate one polynomial on the correction grid. Grid nodes span the analogue
+ * crop, which is the part of the pixel array the sensor actually reads out.
+ */
+void LensShadingCorrection::samplePolynomial(const ipa::LscPolynomial &poly,
+				       float dst[DebayerParams::kLscGridHeight]
+						[DebayerParams::kLscGridWidth]) const
+{
+	const double m = poly.getM();
+	const double x0 = crop_.x / m;
+	const double y0 = crop_.y / m;
+	const double w = crop_.width / m;
+	const double h = crop_.height / m;
+
+	for (unsigned int gy = 0; gy < DebayerParams::kLscGridHeight; gy++) {
+		const double y = static_cast<double>(gy) /
+				 (DebayerParams::kLscGridHeight - 1);
+
+		for (unsigned int gx = 0; gx < DebayerParams::kLscGridWidth; gx++) {
+			const double x = static_cast<double>(gx) /
+					 (DebayerParams::kLscGridWidth - 1);
+
+			dst[gy][gx] = static_cast<float>(
+				poly.sampleAtNormalizedPixelPos(x0 + x * w,
+								y0 + y * h));
+		}
+	}
+}
+
+void LensShadingCorrection::prepare(IPAContext &context,
+				    [[maybe_unused]] const uint32_t frame,
+				    [[maybe_unused]] IPAFrameContext &frameContext,
+				    DebayerParams *params)
+{
+	if (sets_.empty()) {
+		params->shading.width = 0;
+		params->shading.height = 0;
+		context.activeState.lsc.meanGain = 1.0f;
+		context.activeState.lsc.valid = false;
+		return;
+	}
+
+	/*
+	 * The colour temperature comes from AWB, which in turn evaluates the
+	 * image through these grids. Follow a smoothed estimate and blend the
+	 * two neighbouring sets instead of switching between them: a hard
+	 * switch at a set boundary changes the colour, which moves the
+	 * estimate back across the boundary, and the two then flip every
+	 * statistics period (seen as a green flicker every four frames).
+	 */
+	const double ctNow = context.activeState.awb.temperatureK;
+	ctFiltered_ = ctFiltered_ > 0.0 ? 0.7 * ctFiltered_ + 0.3 * ctNow : ctNow;
+	const unsigned int ct = static_cast<unsigned int>(std::lround(ctFiltered_));
+
+	if (lastCt_ &&
+	    std::abs(static_cast<int>(ct) - static_cast<int>(lastCt_)) < 25)
+		return;
+
+	lastCt_ = ct;
+
+	auto hi = sets_.lower_bound(ct);
+	auto lo = hi;
+	double t = 0.0;
+	if (hi == sets_.end()) {
+		--hi;
+		lo = hi;
+	} else if (hi != sets_.begin() && hi->first != ct) {
+		lo = std::prev(hi);
+		t = static_cast<double>(ct - lo->first) / (hi->first - lo->first);
+	}
+
+	auto sampleBlend = [&](const char *name,
+			       float dst[DebayerParams::kLscGridHeight][DebayerParams::kLscGridWidth]) {
+		sampleInto(lo->second.find(name)->second, dst);
+		if (t <= 0.0)
+			return;
+		float other[DebayerParams::kLscGridHeight][DebayerParams::kLscGridWidth];
+		sampleInto(hi->second.find(name)->second, other);
+		for (unsigned int y = 0; y < DebayerParams::kLscGridHeight; y++)
+			for (unsigned int x = 0; x < DebayerParams::kLscGridWidth; x++)
+				dst[y][x] = static_cast<float>(dst[y][x] * (1.0 - t) + other[y][x] * t);
+	};
+	sampleBlend("r", params->shading.r);
+	sampleBlend("gr", params->shading.gr);
+	sampleBlend("gb", params->shading.gb);
+	sampleBlend("b", params->shading.b);
+	const unsigned int setLo = lo->first, setHi = hi->first;
+
+	/*
+	 * The grids are applied as they are: AWB evaluates the colour of the
+	 * corrected image from zoned statistics and the grids themselves, so
+	 * any global per-channel scale in them is absorbed by the white
+	 * balance gains, and the spatial colour correction is preserved
+	 * everywhere, including the image centre. Only the mean green gain is
+	 * needed elsewhere, by AGC, to judge the brightness of the output.
+	 */
+	auto mean = [](const float grid[DebayerParams::kLscGridHeight]
+				       [DebayerParams::kLscGridWidth]) {
+		double sum = 0.0;
+		for (unsigned int y = 0; y < DebayerParams::kLscGridHeight; y++)
+			for (unsigned int x = 0; x < DebayerParams::kLscGridWidth; x++)
+				sum += grid[y][x];
+		return sum / (DebayerParams::kLscGridHeight * DebayerParams::kLscGridWidth);
+	};
+	const double meanG = (mean(params->shading.gr) + mean(params->shading.gb)) / 2.0;
+	context.activeState.lsc.meanGain = static_cast<float>(meanG);
+
+	static_assert(DebayerParams::kLscGridWidth == 17 && DebayerParams::kLscGridHeight == 17);
+	std::copy(&params->shading.r[0][0], &params->shading.r[0][0] + 17 * 17, &context.activeState.lsc.r[0][0]);
+	std::copy(&params->shading.gr[0][0], &params->shading.gr[0][0] + 17 * 17, &context.activeState.lsc.gr[0][0]);
+	std::copy(&params->shading.gb[0][0], &params->shading.gb[0][0] + 17 * 17, &context.activeState.lsc.gb[0][0]);
+	std::copy(&params->shading.b[0][0], &params->shading.b[0][0] + 17 * 17, &context.activeState.lsc.b[0][0]);
+	context.activeState.lsc.valid = true;
+
+	LOG(IPASoftLsc, Debug) << "Shading set " << setLo << "-" << setHi << " K (t " << t << ") for ct "
+			       << ct << ", mean gain " << meanG
+			       << ", centre r/gr/gb/b " << params->shading.r[8][8] << "/"
+			       << params->shading.gr[8][8] << "/" << params->shading.gb[8][8] << "/"
+			       << params->shading.b[8][8] << ", corner r/gr/gb/b "
+			       << params->shading.r[0][0] << "/" << params->shading.gr[0][0] << "/"
+			       << params->shading.gb[0][0] << "/" << params->shading.b[0][0];
+
+	params->shading.width = DebayerParams::kLscGridWidth;
+	params->shading.height = DebayerParams::kLscGridHeight;
+}
+
+REGISTER_IPA_ALGORITHM(LensShadingCorrection, "LensShadingCorrection")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */

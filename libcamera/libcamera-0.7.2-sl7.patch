+{
+	vec3 c0 = texture2D(tex_y, vec2(textureOut.x - 0.5 * tex_step.x, textureOut.y)).rgb;
+	vec3 c1 = texture2D(tex_y, vec2(textureOut.x + 0.5 * tex_step.x, textureOut.y)).rgb;
+	vec3 avg = 0.5 * (c0 + c1);
+
+	float y0 = dot(c0, kY);
+	float y1 = dot(c1, kY);
+	float u = dot(avg, kU);
+	float v = dot(avg, kV);

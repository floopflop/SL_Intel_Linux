diff -ruN -x '*.orig' -x '*.rej' -x build srpm/src/src/libcamera/shaders/denoise.frag libcamera-work/src/libcamera/shaders/denoise.frag
--- srpm/src/src/libcamera/shaders/denoise.frag	1969-12-31 19:00:00.000000000 -0500
+++ libcamera-work/src/libcamera/shaders/denoise.frag	2026-10-28 13:42:28.127029109 -0400
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Red Hat Inc.
+ *
+ * denoise.frag - Edge-preserving chroma (and light luma) denoise
+ *
+ * Second pass of the GPU software ISP. The input is the fully processed,
+ * gamma encoded RGB frame produced by the debayer pass at the output size.
+ * The image is split into luma and chroma; chroma is averaged over a square
+ * window with bilateral weights (close in space, close in chroma and close
+ * in luma) so that the colour speckle of a high gain frame is smoothed while
+ * real colour edges and luma edges stay sharp. Luma gets an optional, much
+ * weaker bilateral pass with its own sigma.
+ *
+ * All sigmas are in the [0, 1] range of the gamma encoded output.
+ */
+
+#ifdef GL_ES
+precision highp float;
+#endif
+
+varying vec2 textureOut;
+uniform sampler2D tex_y;
+uniform vec2 tex_step;
+uniform float chromaSigma;
+uniform float lumaSigma;
+uniform float lumaStrength;
+
+#if !defined(DENOISE_RADIUS)
+#define DENOISE_RADIUS 3
+#endif
+
+/* Column-major: columns are the contributions of R, G and B (BT.601). */
+const mat3 rgb2yuv = mat3(0.299, -0.168736, 0.5,
+                          0.587, -0.331264, -0.418688,
+                          0.114, 0.5, -0.081312);
+const mat3 yuv2rgb = mat3(1.0, 1.0, 1.0,
+                          0.0, -0.344136, 1.772,
+                          1.402, -0.714136, 0.0);
+
+void main(void)
+{
+	vec3 centre = rgb2yuv * texture2D(tex_y, textureOut).rgb;
+
+	/*
+	 * Chroma is guided by luma with a wider sigma than the luma noise
+	 * itself, so a luma edge stops chroma bleeding across it while
+	 * luma noise alone does not break the chroma average up.
+	 */
+	float guideSigma = max(3.0 * lumaSigma, 2.0 * chromaSigma);
+	float invChroma2 = -0.5 / (chromaSigma * chromaSigma + 1e-8);
+	float invGuide2 = -0.5 / (guideSigma * guideSigma + 1e-8);
+	float invLuma2 = -0.5 / (lumaSigma * lumaSigma + 1e-8);
+	const float spatial = float(DENOISE_RADIUS) * 0.6;
+	float invSpatial2 = -0.5 / (spatial * spatial);
+
+	vec2 chroma = vec2(0.0);
+	float wChroma = 0.0;
+	float luma = 0.0;
+	float wLuma = 0.0;
+
+	for (int j = -DENOISE_RADIUS; j <= DENOISE_RADIUS; j++) {
+		for (int i = -DENOISE_RADIUS; i <= DENOISE_RADIUS; i++) {
+			vec2 off = vec2(float(i), float(j));
+			vec3 p = rgb2yuv * texture2D(tex_y, textureOut + off * tex_step).rgb;
+			float ws = dot(off, off) * invSpatial2;
+			float dy = p.x - centre.x;
+			vec2 dc = p.yz - centre.yz;
+
+			float wc = exp(ws + dot(dc, dc) * invChroma2 + dy * dy * invGuide2);
+			chroma += wc * p.yz;
+			wChroma += wc;
+
+			float wl = exp(ws + dy * dy * invLuma2);
+			luma += wl * p.x;
+			wLuma += wl;
+		}
+	}
+
+	vec3 yuv = vec3(mix(centre.x, luma / wLuma, lumaStrength), chroma / wChroma);
+	vec3 rgb = clamp(yuv2rgb * yuv, 0.0, 1.0);
+
+#if defined (SWAP_BLUE)
+	gl_FragColor = vec4(rgb.bgr, 1.0);
+#else
+	gl_FragColor = vec4(rgb, 1.0);
+#endif
+}

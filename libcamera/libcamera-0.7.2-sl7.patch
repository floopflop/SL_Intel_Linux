diff -ruN -x '*.orig' -x '*.rej' -x build srpm/src/src/libcamera/shaders/temporal.frag libcamera-work/src/libcamera/shaders/temporal.frag
--- srpm/src/src/libcamera/shaders/temporal.frag	1969-12-31 19:00:00.000000000 -0500
+++ libcamera-work/src/libcamera/shaders/temporal.frag	2026-10-29 08:44:25.145340736 -0400
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Red Hat Inc.
+ *
+ * temporal.frag - Motion-adaptive temporal (recursive) denoise
+ *
+ * Third pass of the GPU software ISP. The output of the previous frame is
+ * kept as a history texture and blended into the current frame where the
+ * picture has not changed: a recursive average with weight w on the history
+ * lowers the noise by sqrt((1 - w) / (1 + w)) (w = 0.75: to 38 %, 0.5: to
+ * 58 %). Luma and chroma have separate weights: a slowly moving smooth
+ * surface lags by w of each change, which the eye notices in luma but
+ * hardly in colour, while colour blotches are what the filter removes best.
+ *
+ * Motion is detected from the mean absolute difference between the current
+ * frame and the history over a 3x3 window (all three channels), so that
+ * noise alone does not read as motion. The thresholds are multiples of the
+ * expected per-pixel noise of the frame (from the IPA, by analogue gain):
+ * below motionLow sigmas the history is used with the full strength, above
+ * motionHigh it is dropped and the pixel is the current one. Any trail a
+ * moving object can leave is therefore of the order of the noise itself.
+ *
+ * sigma is in the [0, 1] range of the gamma encoded output.
+ */
+
+#ifdef GL_ES
+precision highp float;
+#endif
+
+varying vec2 textureOut;
+uniform sampler2D tex_y;	/* current frame (spatially denoised) */
+uniform sampler2D tex_prev;	/* previous output of this pass */
+uniform vec2 tex_step;
+uniform float sigma;
+uniform float strength;		/* luma weight of the history */
+uniform float chromaStrength;	/* chroma weight of the history */
+uniform float motionLow;
+uniform float motionHigh;
+
+/* Column-major: columns are the contributions of R, G and B (BT.601). */
+const mat3 rgb2yuv = mat3(0.299, -0.168736, 0.5,
+                          0.587, -0.331264, -0.418688,
+                          0.114, 0.5, -0.081312);
+const mat3 yuv2rgb = mat3(1.0, 1.0, 1.0,
+                          0.0, -0.344136, 1.772,
+                          1.402, -0.714136, 0.0);
+
+void main(void)
+{
+	vec3 cur = texture2D(tex_y, textureOut).rgb;
+	vec3 prev = texture2D(tex_prev, textureOut).rgb;
+
+	float d = 0.0;
+	for (int j = -1; j <= 1; j++) {
+		for (int i = -1; i <= 1; i++) {
+			vec2 p = textureOut + vec2(float(i), float(j)) * tex_step;
+			vec3 diff = abs(texture2D(tex_y, p).rgb - texture2D(tex_prev, p).rgb);
+			d += diff.r + diff.g + diff.b;
+		}
+	}
+	/* Mean over 9 pixels and 3 channels. */
+	d *= 1.0 / 27.0;
+
+	float still = 1.0 - smoothstep(motionLow * sigma, motionHigh * sigma, d);
+	vec3 c = rgb2yuv * cur;
+	vec3 p = rgb2yuv * prev;
+	vec3 yuv = vec3(mix(c.x, p.x, strength * still),
+			mix(c.yz, p.yz, chromaStrength * still));
+	gl_FragColor = vec4(clamp(yuv2rgb * yuv, 0.0, 1.0), 1.0);
+}

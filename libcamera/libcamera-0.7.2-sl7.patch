+	for (const auto &plane : it->second->planes()) {
+		uint8_t *p = const_cast<uint8_t *>(plane.data());
+		uint8_t *end = p + plane.size();
+		for (; p < end; p += 64) {
+			if (haveOpt)
+				__asm__ volatile("clflushopt %0" : "+m"(*p));
+			else
+				__asm__ volatile("clflush %0" : "+m"(*p));
+		}

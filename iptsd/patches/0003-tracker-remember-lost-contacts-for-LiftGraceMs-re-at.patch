+++ b/src/contacts/tracking/config.hpp
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#ifndef IPTSD_CONTACTS_TRACKING_CONFIG_HPP
+#define IPTSD_CONTACTS_TRACKING_CONFIG_HPP
+
+#include <common/types.hpp>
+
+#include <type_traits>
+
+namespace iptsd::contacts::tracking {
+
+template <class T>
+struct Config {
+public:
+	static_assert(std::is_floating_point_v<T>);
+
+public:
+	/*
+	 * Max normalized distance a contact may move between two consecutive frames
+	 * and still be tracked as the same contact. Farther apart means lift and
+	 * reposition: the contact gets a fresh index and emits no stale delta.
+	 */
+	T reposition_ceiling = static_cast<T>(0.15);
+
+	/*
+	 * Max normalized distance between a contact that disappeared less than
+	 * grace_ms ago and a newly detected contact for the new contact to inherit
+	 * the old index. Bridges single-frame detection dropouts ("blinking").
+	 */
+	T lost_ceiling = static_cast<T>(0.06);
+
+	/*
+	 * How long a disappeared contact is remembered for re-matching, and how
+	 * long its index stays reserved so that a new contact cannot collide with
+	 * an index the consumer may still be holding. 0 disables the feature.
+	 */
+	f64 grace_ms = 0;
+};
+
+} // namespace iptsd::contacts::tracking
+
+#endif // IPTSD_CONTACTS_TRACKING_CONFIG_HPP

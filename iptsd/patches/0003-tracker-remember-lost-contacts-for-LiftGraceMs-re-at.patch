+					    }),
+			     m_lost.end());
+
+		m_candidates.clear();
+		std::copy(m_last.begin(), m_last.end(), std::back_inserter(m_candidates));
+		for (const Lost &l : m_lost)
+			m_candidates.push_back(l.contact);
+
+		// Provisional indices: never collide with any index that is still in use
+		// by the last frame or reserved by a recently lost contact.
 		usize counter = 0;
-
-		// Assign unique indices to all contacts of the current frame.
 		for (Contact<T> &contact : frame) {
 			contact.index = this->find_new_index(counter);
 			counter = contact.index.value() + 1;
 		}
 
-		if (!m_last.empty()) {
-			const usize min = std::min(frame.size(), m_last.size());
-
-			// Calculate the distances between all contacts from the current and last
-			// frame
-			distances::calculate(frame, m_last, m_distances);
+		if (!m_candidates.empty()) {
+			const usize ncand = m_candidates.size();
+			const usize nlast = m_last.size();
+			const usize min = std::min(frame.size(), ncand);
+
+			m_matched.assign(ncand, false);
+			distances::calculate(frame, m_candidates, m_distances);
+
+			// Lost contacts may only re-attach within a tighter radius.
+			for (usize y = nlast; y < ncand; y++) {
+				for (Eigen::Index x = 0; x < m_distances.cols(); x++) {
+					if (m_distances(casts::to_eigen(y), x) > m_config.lost_ceiling)
+						m_distances(casts::to_eigen(y), x) =
+							Eigen::NumTraits<T>::infinity();
+				}
+			}
 
-			// Copy the old indices back for the amount of contacts that can be tracked.
 			for (usize i = 0; i < min; i++) {
 				Eigen::Index y = 0;
 				Eigen::Index x = 0;
 
 				const T dist = m_distances.minCoeff(&y, &x);
 
-				// Lift+reposition guard: nearest match too far to be real motion → stop
-				// inheriting indices. minCoeff returns the smallest remaining distance, so
-				// once it exceeds the ceiling every other unmatched pair is too far as well.
-				if (dist > m_reposition_ceiling)
+				// Nearest remaining pair too far apart to be real motion: stop
+				// inheriting indices. Every other unmatched pair is farther still.
+				if (dist > m_config.reposition_ceiling)
 					break;
 
-				// Copy the index of the contact
-				frame[casts::to_unsigned(x)].index =
-					m_last[casts::to_unsigned(y)].index;
+				frame[casts::to_unsigned(x)].index = m_candidates[casts::to_unsigned(y)].index;
+				m_matched[casts::to_unsigned(y)] = true;
 
-				// Invalidate all entries containing these contacts
 				m_distances.row(y) = Eigen::NumTraits<T>::infinity();
 				m_distances.col(x) = Eigen::NumTraits<T>::infinity();
 			}
 
-			m_last.clear();
+			// Lost contacts that re-attached are no longer lost. m_lost still
+			// corresponds 1:1 to candidates [nlast, ncand) at this point.
+			usize k = nlast;
+			m_lost.erase(std::remove_if(m_lost.begin(), m_lost.end(),
+						    [&](const Lost &) { return m_matched[k++]; }),
+				     m_lost.end());
+
+			// Contacts of the last frame that found no successor become lost.
+			if (m_config.grace_ms > 0) {
+				for (usize y = 0; y < nlast; y++) {
+					if (!m_matched[y])
+						m_lost.push_back(Lost {m_last[y], now_ms});
+				}
+			}
 		}
 
-		// Save a copy of the new data
+		m_last.clear();
 		std::copy(frame.begin(), frame.end(), std::back_inserter(m_last));
 	}
 
 private:
 	/*!
-	 * Searches for an index that is not already used by a contact from the last frame.
-	 *
-	 * @param[in] min The new index has to be at least this value.
-	 * @return A new unique index that was not used before.
+	 * Finds the lowest index that is not used by the last frame or a lost contact.
 	 */
 	[[nodiscard]] usize find_new_index(usize min) const
 	{
 		while (true) {
-			if (!Contact<T>::find_in_frame(min, m_last).has_value())
+			if (!Contact<T>::find_in_frame(min, m_candidates).has_value())
 				return min;
 

@@ -428,6 +443,25 @@ private:
 		}
 	}
 
+	/*!
+	 * Applies exponential smoothing to a contact position. The first sample of a
+	 * contact is passed through unchanged so touch-down position is exact.
+	 */
+	Vector2<f64> smooth(const usize index, const Vector2<f64> &mean)
+	{
+		if (m_position_smoothing <= 0 || m_position_smoothing >= 1)
+			return mean;
+
+		const auto it = m_smoothed.find(index);
+		if (it == m_smoothed.end()) {
+			m_smoothed[index] = mean;
+			return mean;
+		}
+
+		it->second += m_position_smoothing * (mean - it->second);
+		return it->second;
+	}
+
 	/*!
 	 * Emits a lift event using the linux multitouch protocol.
 	 */
